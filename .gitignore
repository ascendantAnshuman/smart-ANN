# data + results are never committed (Section 10)
data/*
!data/.gitkeep
results/*
!results/.gitkeep

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# editors / os
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# Generated deliverable: regenerate from docs/viva_handbook.html with
#   chrome --headless=new --no-pdf-header-footer --print-to-pdf=... file:///...
# The source is committed; the 971 KB binary is not.
docs/*.pdf
