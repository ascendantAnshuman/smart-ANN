# data + results are never committed (Section 10)
data/*
!data/.gitkeep
results/*
!results/.gitkeep

# ...with one exception. The Phase 11 demonstration corpus is SOURCE, not data:
# 36 documents written for this project, not downloaded, not derived, and with
# no upstream to re-fetch them from. Ignored like the rest of data/ they would
# be unrecoverable from a fresh clone and the demo would be unreproducible.
!data/demo_phone_care/
!data/demo_phone_care/**

# Query traces are run artifacts, like results/. One is copied into docs/ for
# the viva pack; the rest are regenerated by asking the question again.
traces/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# editors / os
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# Generated deliverable: regenerate from docs/viva_handbook.html with
#   chrome --headless=new --no-pdf-header-footer --print-to-pdf=... file:///...
# The source is committed; the 971 KB binary is not.
docs/*.pdf

# Local datasets (802 MB of vector corpora) -- fetch with scripts, never commit.
datasets/

# Slide decks are built from the docs sources, same rule as the PDFs.
docs/*.pptx

# 1920 px slide figures, regenerated by scripts/phase15_viva_pack.py from the
# files in results/. Same rule as the PDFs above: the source is committed, the
# render is not. Two of them also exceed the 512 KB ceiling this repo's
# pre-commit hook enforces, which is the hook being right rather than in the way.
docs/figures/
