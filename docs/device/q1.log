import numpy as np
try:
    import hnswlib
except Exception as e:
    print("IMPORT_FAILED:", e); raise SystemExit(1)
print("hnswlib imported from", hnswlib.__file__)
d, n = 16, 2000
rng = np.random.default_rng(0)
data = rng.random((n, d)).astype(np.float32)
p = hnswlib.Index(space="l2", dim=d)
p.init_index(max_elements=n, ef_construction=100, M=16)
p.add_items(data, np.arange(n))
p.set_ef(50)
lab, dist = p.knn_query(data[:5], k=5)
exact = ((data[:5][:,None,:]-data[None,:,:])**2).sum(-1)
gt = np.argsort(exact, axis=1)[:, :5]
recall = np.mean([len(set(lab[i]) & set(gt[i]))/5 for i in range(5)])
print("knn_query OK, shapes", lab.shape, dist.shape)
print("self-recall@5 =", recall)
print("FUNCTIONAL_OK" if recall > 0.9 else "FUNCTIONAL_SUSPECT")
